//
//  NeuroNoise.metal
//
//  Ported from ShipSwift's `SWNeuroNoise.metal` (github.com/signerlabs/ShipSwift,
//  MIT — see ACKNOWLEDGEMENTS).
//
//  A glowing web-like structure of fluid lines and soft intersections,
//  generated by 15 layers of iteratively rotated, scale-growing sine/cosine
//  accumulation. The sine accumulator threads "memory" of the previous layer
//  into the next, which is what makes the web look organic.
//
//  Ported, the low band zooms the field, mids sharpen the contrast toward the
//  web's filaments, loudness sets the flow speed, and the overall level sets
//  the brightness. The front/mid/back colours come from the palette.
//

#include "KumoneShaderTypes.h"
using namespace metal;

// 2D rotation by exactly 1 radian (baked in for speed).
static float2 neuroRotate1(float2 p) {
    const float c = 0.5403023058681398;  // cos(1)
    const float s = 0.8414709848078965;  // sin(1)
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

// 15 layers of iteratively rotated, scale-growing sine/cosine accumulation.
static float neuroShape(float2 uv, float t) {
    float2 sineAcc = float2(0.0);
    float2 res = float2(0.0);
    float scale = 8.0;

    for (int j = 0; j < 15; j++) {
        uv      = neuroRotate1(uv);
        sineAcc = neuroRotate1(sineAcc);
        float2 layer = uv * scale + float(j) + sineAcc - t;
        sineAcc += sin(layer);
        res += (0.5 + 0.5 * cos(layer)) / scale;
        scale *= 1.2;
    }
    return res.x + res.y;
}

fragment float4 kumone_fragment_neuro_noise(Varying in [[stage_in]],
                                            constant Uniforms& u [[buffer(0)]]) {
    float2 position = in.uv * u.resolution.y;
    float2 size = u.resolution;

    // Audio: low zooms the web, mids sharpen the filaments, loudness sets the
    // flow, level drives the brightness.
    float scale = 0.35 + u.low * 0.8;
    float contrast = 0.25 + u.mid * 0.6;
    float speed = 0.5 + u.loudness * 1.2;
    float brightness = 0.5 + u.level * 1.2;

    float minDim = max(min(size.x, size.y), 1.0);
    float2 uv = (position - 0.5 * size) / minDim;
    uv *= max(scale, 1e-4);

    float t = 0.5 * speed * u.time;
    float noise = neuroShape(uv, t);

    // Brightness / contrast curve.
    noise = (1.0 + saturate(brightness)) * noise * noise;
    noise = pow(noise, 0.7 + 6.0 * saturate(contrast));
    noise = min(1.4, noise);

    float blend = smoothstep(0.7, 1.4, noise);

    float3 frontRGB = u.paletteAccent.rgb;
    float3 midRGB   = u.palettePrimary.rgb;
    float3 col = mix(midRGB, frontRGB, blend);
    col *= max(noise, 0.0);

    float3 backRGB = u.paletteBackground.rgb;
    col = col + backRGB * (1.0 - saturate(max(noise, 0.0)));

    return float4(col, 1.0);
}
